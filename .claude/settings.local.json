{
  "permissions": {
    "allow": [
      "Bash(moon --version)",
      "WebSearch",
      "WebFetch(domain:www.moonbitlang.com)",
      "WebFetch(domain:mooncakes.io)",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__close_page",
      "Bash(moon test:*)",
      "Bash(moon fmt:*)",
      "Bash(moon doc:*)",
      "WebFetch(domain:docs.moonbitlang.com)",
      "WebFetch(domain:tour.moonbitlang.com)",
      "WebFetch(domain:github.com)",
      "Bash(xargs cat:*)",
      "Bash(moon run:*)",
      "Bash(moon check:*)",
      "Bash(curl -s \"https://mooncakes.io/docs\")",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__evaluate_script",
      "Bash(moon info:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
