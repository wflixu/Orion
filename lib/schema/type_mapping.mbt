/// 类型映射和 DDL 生成
/// MoonBit 类型到 SQL 类型的转换

///|
/// 数据库类型枚举
pub enum DbType {
  SQLite
  PostgreSQL
  MySQL
}

///|
/// 获取 DbType 枚举（从连接字符串）
pub fn parse_db_type(url : String) -> DbType {
  if url.has_prefix("sqlite") {
    DbType::SQLite
  } else if url.has_prefix("postgres") {
    DbType::PostgreSQL
  } else if url.has_prefix("mysql") {
    DbType::MySQL
  } else {
    DbType::SQLite
  }
}

///|
/// MoonBit 类型到 SQL 类型映射
pub fn moonbit_type_to_sql(t : FieldType, db_type : DbType) -> String {
  match db_type {
    DbType::SQLite => moonbit_type_to_sqlite(t)
    DbType::PostgreSQL => moonbit_type_to_postgres(t)
    DbType::MySQL => moonbit_type_to_mysql(t)
  }
}

///|
/// MoonBit 类型到 SQLite 类型映射
fn moonbit_type_to_sqlite(t : FieldType) -> String {
  match t {
    FieldType::Int => "INTEGER"
    FieldType::String => "TEXT"
    FieldType::Bool => "INTEGER"
    FieldType::Float => "REAL"
    FieldType::DateTime => "TEXT"
    FieldType::Json => "TEXT"
    FieldType::Blob => "BLOB"
  }
}

///|
/// MoonBit 类型到 PostgreSQL 类型映射
fn moonbit_type_to_postgres(t : FieldType) -> String {
  match t {
    FieldType::Int => "INTEGER"
    FieldType::String => "TEXT"
    FieldType::Bool => "BOOLEAN"
    FieldType::Float => "DOUBLE PRECISION"
    FieldType::DateTime => "TIMESTAMP"
    FieldType::Json => "JSONB"
    FieldType::Blob => "BYTEA"
  }
}

///|
/// MoonBit 类型到 MySQL 类型映射
fn moonbit_type_to_mysql(t : FieldType) -> String {
  match t {
    FieldType::Int => "INT"
    FieldType::String => "VARCHAR(255)"
    FieldType::Bool => "TINYINT(1)"
    FieldType::Float => "DOUBLE"
    FieldType::DateTime => "DATETIME"
    FieldType::Json => "JSON"
    FieldType::Blob => "BLOB"
  }
}

///|
/// 约束到 SQL 片段映射
pub fn constraint_to_sql(c : Constraint, db_type : DbType) -> String? {
  match c {
    Constraint::PrimaryKey => Some("PRIMARY KEY")
    Constraint::AutoInc => Some(auto_inc_sql(db_type))
    Constraint::NotNull => Some("NOT NULL")
    Constraint::Unique => Some("UNIQUE")
    Constraint::Default(value) =>
      Some("DEFAULT " + default_value_sql(value, db_type))
    Constraint::MaxLength(_) => Some(max_length_sql(db_type))
    Constraint::Index => None
    Constraint::ForeignKey(table, column) =>
      Some("REFERENCES " + table + "(" + column + ")")
  }
}

///|
/// 自增 SQL（不同数据库语法不同）
fn auto_inc_sql(db_type : DbType) -> String {
  match db_type {
    DbType::SQLite => "AUTOINCREMENT"
    DbType::PostgreSQL => "GENERATED BY DEFAULT AS IDENTITY"
    DbType::MySQL => "AUTO_INCREMENT"
  }
}

///|
/// 默认值 SQL（不同数据库语法不同）
fn default_value_sql(value : String, _db_type : DbType) -> String {
  if value == "CURRENT_TIMESTAMP" {
    value
  } else if value == "true" || value == "false" {
    value
  } else if is_numeric(value) {
    value
  } else {
    "'" + value + "'"
  }
}

///|
/// 检查字符串是否为数字
fn is_numeric(s : String) -> Bool {
  let len = s.length()
  if len == 0 {
    return false
  }
  let mut i = 0
  while i < len {
    let c = s[i]
    let code = c.to_int()
    if code < '0'.to_int() || code > '9'.to_int() {
      return false
    }
    i += 1
  }
  true
}

///|
/// 最大长度 SQL（仅 MySQL 支持 VARCHAR(n)）
fn max_length_sql(db_type : DbType) -> String {
  match db_type {
    DbType::MySQL => "VARCHAR(255)"
    _ => ""
  }
}

///|
/// 字段到 SQL 列定义
pub fn field_to_sql(f : FieldDef, db_type : DbType) -> String {
  let sql_type = moonbit_type_to_sql(f.field_type, db_type)
  let parts = [f.name, sql_type]

  for c in f.constraints {
    match constraint_to_sql(c, db_type) {
      Some(sql) => parts.push(sql)
      None => ()
    }
  }

  join_strings(parts, " ")
}

///|
/// 连接字符串数组
fn join_strings(arr : Array[String], sep : String) -> String {
  let len = Array::length(arr)
  if len == 0 {
    ""
  } else if len == 1 {
    arr[0]
  } else {
    let mut result = arr[0]
    let mut i = 1
    while i < len {
      result = result + sep + arr[i]
      i += 1
    }
    result
  }
}

///|
/// 索引到 SQL 语句
pub fn index_to_sql(idx : IndexDef, table_name : String) -> String {
  let unique_keyword = if idx.unique { "UNIQUE " } else { "" }
  let columns_sql = join_strings(idx.columns, ", ")
  "CREATE " +
  unique_keyword +
  "INDEX " +
  idx.name +
  " ON " +
  table_name +
  " (" +
  columns_sql +
  ")"
}

///|
/// 生成 CREATE TABLE 语句
pub fn generate_create_table_sql(
  schema : TableSchema,
  db_type : DbType,
) -> String {
  let column_defs = []

  for f in schema.fields {
    column_defs.push(field_to_sql(f, db_type))
  }

  let columns_sql = join_strings(column_defs, ",\n  ")

  let mut sql = "CREATE TABLE " + schema.name + " (\n  " + columns_sql

  if Array::length(schema.indexes) > 0 {
    sql = sql + "\n)"
    let mut i = 0
    let idx_len = Array::length(schema.indexes)
    while i < idx_len {
      sql = sql + ";\n" + index_to_sql(schema.indexes[i], schema.name)
      i += 1
    }
    sql + ";"
  } else {
    sql + "\n);"
  }
}

///|
/// 生成 DROP TABLE 语句
pub fn generate_drop_table_sql(schema : TableSchema) -> String {
  "DROP TABLE IF EXISTS " + schema.name + ";"
}

///|
/// 生成完整的迁移 SQL（DROP + CREATE）
pub fn generate_migration_sql(schema : TableSchema, db_type : DbType) -> String {
  generate_drop_table_sql(schema) +
  "\n" +
  generate_create_table_sql(schema, db_type)
}

///|
/// Schema 验证错误
pub struct SchemaValidationError {
  field : String
  message : String
}

///|
/// 创建验证错误
pub fn make_schema_error(
  field : String,
  message : String,
) -> SchemaValidationError {
  { field, message }
}

///|
/// 验证 Schema 是否合法
pub fn validate_schema(schema : TableSchema) -> Array[SchemaValidationError] {
  let errors = []

  let mut pk_count = 0
  let mut auto_inc_count = 0

  for f in schema.fields {
    for c in f.constraints {
      match c {
        Constraint::PrimaryKey => pk_count += 1
        Constraint::AutoInc => auto_inc_count += 1
        _ => ()
      }
    }

    let validation = validate_constraints(f.constraints)
    if !validation.valid {
      let err_len = Array::length(validation.errors)
      let mut i = 0
      while i < err_len {
        errors.push(make_schema_error(f.name, validation.errors[i]))
        i += 1
      }
    }
  }

  if pk_count > 1 {
    errors.push(make_schema_error("*", "Multiple primary keys defined"))
  }

  if auto_inc_count > 1 {
    errors.push(make_schema_error("*", "Multiple AUTO_INCREMENT defined"))
  }

  errors
}
