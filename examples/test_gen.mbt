// Test script to demonstrate code generation from SQL

///|
fn main {
  // 示例 SQL 内容
  let sql = "-- name: getUserById\n-- description: Get user by ID\n-- result: single\nSELECT id, name, age FROM users WHERE id = ?;"

  // 解析 SQL
  let result = @parser.parse_sql_file(sql)

  match result {
    Ok(queries) => {
      println("Parsed " + Int::to_string(Array::length(queries)) + " queries:")
      for q in queries {
        println("  - " + q.name + ": " + q.sql)
      }

      // 生成代码
      let fields = [("id", "Int"), ("name", "String"), ("age", "Int")]
      let mut code = "// Generated by Orion\n\n"

      // 生成结构体
      code = code + @codegen.gen_struct("User", fields)

      // 生成映射函数
      code = code + @codegen.gen_from_db_value("User", fields)

      // 生成查询函数
      for q in queries {
        code = code + @codegen.gen_function(q, "User")
      }

      println("\nGenerated code:")
      println(code)
    }
    Err(e) => println("Parse error: " + e)
  }
}
